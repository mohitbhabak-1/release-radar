# Copy to .env.local (never commit). In CI these come from GitHub Actions secrets.

# Fine-grained, READ-ONLY token. Resource owner: BitGo org. Repository access: all repos (or selected).
# Permissions: Metadata (read), Pull requests (read), Contents (read, needed for releases).
GITHUB_TOKEN=

# Anthropic API key (used from Phase 5)
ANTHROPIC_API_KEY=

# OpenRouter key (alternative to the Anthropic key; used from Phase 5)
OPENROUTER_API_KEY=

# Read-only Linear key (unused while linear.enabled=false)
LINEAR_API_KEY=
